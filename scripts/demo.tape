# README demo — regenerate with:
#   scripts/demo-seed.sh && vhs scripts/demo.tape
# Records the real binary over the seeded /tmp/den-demo folder.
# Note: the cursor starts on the alphabetically first repo (aurora),
# which renders last in display order — hence Left to reach vector.

Output assets/demo.gif

Set FontSize 14
Set Width 1100
Set Height 640
Set Padding 14
Set TypingSpeed 60ms

Type "den /tmp/den-demo"
Enter
Sleep 4s

# den starts with the detail pane open on the first repo — close it
Enter
Sleep 1.2s

Left
Sleep 900ms

Enter
Sleep 3.5s
Enter
Sleep 1s

Up
Sleep 900ms
Sleep 2.5s
